<?xml version="1.0" encoding="utf-8"?>
<!--
  The app's mark: a page, being scanned.

  Drawn as vectors rather than shipped as bitmaps so the shape sharpens at every
  density and so this file can be reused as the launch screen's logo, the
  monochrome (themed icon) layer, and the launcher icon's foreground on API 26+,
  which is every device this app supports.

  Everything sits inside the adaptive icon's 66 × 66 dp safe zone: the outer ring
  can be masked into a circle, a squircle or a teardrop by the launcher.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The page. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M41,26 h26 a5,5 0 0 1 5,5 v46 a5,5 0 0 1 -5,5 h-26 a5,5 0 0 1 -5,-5 v-46 a5,5 0 0 1 5,-5 z"
        android:strokeColor="#FFFFFF"
        android:strokeLineJoin="round"
        android:strokeWidth="4" />

    <!-- Two lines of text on it, so it reads as a document and not a phone. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M45,38 h18"
        android:strokeColor="#B3FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="3.5" />
    <path
        android:fillColor="#00000000"
        android:pathData="M45,46 h11"
        android:strokeColor="#B3FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="3.5" />
    <path
        android:fillColor="#00000000"
        android:pathData="M45,70 h18"
        android:strokeColor="#B3FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="3.5" />

    <!-- The scan itself: the amber line the whole app is built around. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M31,58 h46"
        android:strokeColor="#FFB020"
        android:strokeLineCap="round"
        android:strokeWidth="4.5" />
</vector>
