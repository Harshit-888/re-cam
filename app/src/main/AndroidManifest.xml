<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera capture. Gallery import uses the system photo picker
         (PickVisualMedia), which needs no storage permission. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
      largeHeap: the filter pipeline holds an ARGB IntArray plus a luminance
      FloatArray for the whole page (roughly 2 x 4 bytes x pixels). For a 2600 px
      capture that is ~50 MB on top of the decoded bitmap. Without the larger
      ceiling, mid-range devices throw OutOfMemoryError while baking a page.
    -->
    <application
        android:largeHeap="true"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.DocScanner">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Required for sharing exported PDFs. Without this, every
          FileProvider.getUriForFile() call throws and PDF sharing silently
          fails — which is what happened before.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
